{
  "private": true,
  "scripts": {
    "generate-placeholders": "tsx 'src/app/(main)/blog/scripts/generate-blur-placeholders.ts'",
    "typegen": "next typegen",
    "type-check": "pnpm typegen && tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "build": "pnpm generate-placeholders && pnpm type-check && next build",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,css,scss}' && eslint --fix '**/*.{js,jsx,ts,tsx}'",
    "dev": "next dev",
    "postinstall": "pnpm generate-placeholders || true"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.4",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.38.0",
    "motion": "^13.1.1",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwind-merge": "^3.6.0",
    "three": "0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "0.185.4",
    "agentation": "^3.0.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "plaiceholder": "^3.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
